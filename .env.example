DATABASE_URL=postgresql://dev:dev@localhost:15432/event_timeline
REDIS_URL=redis://localhost:16379
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_CATEGORY_DELAY_MS=12000

# Optional: Valyu news search — not required; regional hotspots use GDELT conflict_* queries
VALYU_API_KEY=
VALYU_QUERY_DELAY_MS=2000
VALYU_MAX_RESULTS=20
VALYU_LOOKBACK_DAYS=7

# USGS earthquake feed (free, no key required)
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
USGS_MIN_MAGNITUDE=4.5

# Hot-trend: enable/platforms/API URL are configured in 系统设置 → 数据源
# HOT_TREND_ENABLED env var is no longer used; use settings UI instead
NEWSNOW_API_URL=https://newsnow.busiyi.world/api/s
